# Copy to ~/.runtime/.env on the machine that needs it, then fill in the
# values YOURSELF in a text editor. Never paste secrets into a chat or a
# shell command — history and transcripts keep them forever.
#
# ~/.runtime/.env is read by verify_jobs.py (paging) and pocket_ingest.py.

# Gmail app password for exception paging (create one at
# https://myaccount.google.com/apppasswords — requires 2FA on the account):
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# Pocket AI API key (Pocket app -> Settings -> Developer/API), for pocket_ingest:
POCKET_API_KEY=
